#!/usr/bin/env bash
# Fake opencode CLI for cheap-coder tests.
#
# Behavior is driven by env vars set by the test case:
#   FAKE_OPENCODE_SCRIPT       - bash script that mutates the working tree
#                                (run with cwd = the --dir argument or cwd)
#   FAKE_OPENCODE_SUMMARY      - final JSONL `text` event text. Default "did the work"
#   FAKE_OPENCODE_ERROR        - emit a JSONL `error` event with this message
#   FAKE_OPENCODE_EXIT_CODE    - exit code. Default 0
#   FAKE_OPENCODE_EMIT_NOTHING - if 1, emit no JSONL (simulates a crash)
#   FAKE_OPENCODE_SESSION_ID   - session id on every event. Default ses_FAKE0001
#   FAKE_OPENCODE_ARGV_LOG     - path to record the invocation:
#                                  SESSION=<--session value, empty if absent>
#                                  MODEL=<--model value, empty if absent>
#                                  CONFIG_SET=1     (if OPENCODE_CONFIG_CONTENT set)
#                                  STANDALONE=1     (if --standalone passed)
#                                  MESSAGE_BEGIN ... MESSAGE_END (the task)
#
# Args mirror cheap-coder's v2 usage:
#   opencode run --standalone --format json [--session <id>] [--model <id>] "<task>"

set -e

DIR=""
SESSION_ARG=""
MODEL_ARG=""
MESSAGE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dir)
      DIR=$2
      shift 2
      ;;
    --session)
      SESSION_ARG=$2
      shift 2
      ;;
    --model)
      MODEL_ARG=$2
      shift 2
      ;;
    --format)
      shift 2
      ;;
    --standalone)
      STANDALONE=1
      shift
      ;;
    run)
      shift
      ;;
    *)
      MESSAGE=$1
      shift
      ;;
  esac
done

# v2 has no --dir: the CLI runs in its own cwd; fall back to $PWD.
DIR=${DIR:-$PWD}

# Record the invocation for cases that assert flag passthrough and header
# stripping. Written outside $DIR so it never appears as an untracked file.
if [ -n "${FAKE_OPENCODE_ARGV_LOG:-}" ]; then
  {
    printf 'SESSION=%s\n' "$SESSION_ARG"
    printf 'MODEL=%s\n' "$MODEL_ARG"
    if [ -n "${OPENCODE_CONFIG_CONTENT:-}" ]; then
      printf 'CONFIG_SET=1\n'
    fi
    if [ -n "${STANDALONE:-}" ]; then
      printf 'STANDALONE=1\n'
    fi
    printf 'MESSAGE_BEGIN\n'
    printf '%s\n' "$MESSAGE"
    printf 'MESSAGE_END\n'
  } > "$FAKE_OPENCODE_ARGV_LOG"
fi

# Run the prescribed mutation script in the target dir.
if [ -n "$FAKE_OPENCODE_SCRIPT" ] && [ -f "$FAKE_OPENCODE_SCRIPT" ]; then
  ( cd "$DIR" && bash "$FAKE_OPENCODE_SCRIPT" )
fi

# Emit prescribed JSONL events. Every event carries "sessionID" (mirrors real
# opencode); the padding events push the stream past the 100-byte
# "unusually small output" anomaly threshold.
if [ "$FAKE_OPENCODE_EMIT_NOTHING" != "1" ]; then
  SID=${FAKE_OPENCODE_SESSION_ID:-ses_FAKE0001}
  printf '{"sessionID":"%s","type":"status","status":"running"}\n' "$SID"
  printf '{"sessionID":"%s","type":"tool_use","tool":"edit","status":"complete"}\n' "$SID"
  if [ -n "$FAKE_OPENCODE_ERROR" ]; then
    # v1 error-event shape; the engine's jq filter accepts both shapes.
    printf '{"sessionID":"%s","type":"error","error":{"name":"ToolError","data":{"message":%s}}}\n' \
      "$SID" \
      "$(printf '%s' "$FAKE_OPENCODE_ERROR" | node -e 'process.stdout.write(JSON.stringify(require("fs").readFileSync(0,"utf8")))')"
  fi

  SUMMARY=${FAKE_OPENCODE_SUMMARY:-"did the work"}
  printf '{"sessionID":"%s","type":"text","part":{"text":%s}}\n' \
    "$SID" \
    "$(printf '%s' "$SUMMARY" | node -e 'process.stdout.write(JSON.stringify(require("fs").readFileSync(0,"utf8")))')"
fi

exit "${FAKE_OPENCODE_EXIT_CODE:-0}"
